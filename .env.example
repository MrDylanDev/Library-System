# === PLANTILLA DE VARIABLES DE DESARROLLO ===
# Copiar a .env y completar los valores. NO subir .env al repositorio.
#   cp .env.example .env
# (docker compose lee .env automáticamente para el compose de desarrollo)

# --- Seguridad ---
# Secret para firmar JWT (>= 32 chars). En dev puede ser un valor fijo;
# en producción usar un valor aleatorio: openssl rand -base64 48
JWT_SECRET=

# --- Perfil de Spring ---
# dev = desarrollo (H2/default), prod = producción (PostgreSQL + SMTP real)
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos (compose dev) ---
# Debe coincidir con SPRING_DATASOURCE_PASSWORD del service app
# en docker-compose.yml (por defecto: libromagico).
POSTGRES_PASSWORD=libromagico

# --- Email — SMTP (solo para prod; MailHog se usa en dev) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=