# === PLANTILLA DE VARIABLES DE PRODUCCIÓN ===
# Copiar a .env.prod y completar los valores. NO subir .env.prod al repositorio.
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml -p libromagico up -d --build

# --- Seguridad (obligatorios) ---
# Secret para firmar JWT: usar un valor aleatorio largo (>= 32 chars).
# Generar con: openssl rand -base64 48
JWT_SECRET=
# Orígenes CORS permitidos (coma-separados, sin espacios).
# Ej: https://libromagico.example.com,https://admin.libromagico.example.com
CORS_ALLOWED_ORIGINS=

# --- Base de datos (obligatorios) ---
DB_USER=libromagico
DB_PASS=

# --- URL base pública de la app (obligatorio; usado en emails de reset) ---
APP_BASE_URL=https://libromagico.example.com

# --- Puerto del host (opcional, por defecto 8080) ---
# Debe definirse aquí (env-file) o en el entorno: el compose lo lee como ${APP_PORT:-8080}
# APP_PORT=8080

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@libromagico.com
# --- Nombre del proyecto / prefijo de contenedores (opcional) ---
# Por defecto los contenedores se llaman <proyecto>-app y <proyecto>-db.
# Para un nombre estable y evitar colisiones entre stacks use -p:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml -p libromagico-prod up -d --build
# Alternativamente, defina COMPOSE_PROJECT_NAME=libromagico-prod como variable de entorno.
